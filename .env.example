DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret
ALLOWED_HOSTS=api.vastrabook.in,localhost,127.0.0.1

DB_NAME=vastrabook
DB_USER=vastrabook
DB_PASSWORD=change-this-db-password
DB_HOST=postgres
DB_PORT=5432

# Redis — required for Celery background tasks
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

BACKEND_IMAGE=ghcr.io/veltacore1/vectacore-bill-book-backend:latest
FRONTEND_IMAGE=ghcr.io/veltacore1/vectacore-bill-book-frontend:latest
NGINX_REVERSE_PROXY_IMAGE=nginx:1.27-alpine
BACKEND_PUBLIC_PORT=8001
FRONTEND_PUBLIC_PORT=8080
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# When USE_REVERSE_PROXY=true, the stack uses a single nginx container
# (bound to port 80/443) that serves the frontend SPA and proxies /api/* to the backend.
# Set DOMAIN to your server's domain for SSL via a companion like Caddy or certbot.
USE_REVERSE_PROXY=false
DOMAIN=app.vastrabook.in

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.vastrabook.in,http://localhost:5173,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=https://app.vastrabook.in,http://localhost:5173,http://127.0.0.1:5174

DEMO_SESSION_ENABLED=False
DEMO_TENANT_MOBILE=8608633066
SEED_DEMO_DATA=False

SMS_PROVIDER=your_sms_provider
SMS_PROVIDER_API_URL=https://provider.example/send
SMS_PROVIDER_API_TOKEN=change-this-sms-token

EMAIL_PROVIDER=resend
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=change-this-resend-key
RESEND_FROM_EMAIL=reports@your-domain.example
EMAIL_REPLY_TO=

PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=change-this-razorpay-key-id
RAZORPAY_KEY_SECRET=change-this-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=change-this-razorpay-webhook-secret

SHIPPING_PROVIDER=shiprocket
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=ops@your-domain.example
SHIPROCKET_PASSWORD=change-this-shiprocket-password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_DEFAULT_LENGTH_CM=30
SHIPROCKET_DEFAULT_BREADTH_CM=24
SHIPROCKET_DEFAULT_HEIGHT_CM=5
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5

WHATSAPP_PROVIDER=gupshup
GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg
GUPSHUP_API_KEY=change-this-gupshup-api-key
GUPSHUP_APP_NAME=your-gupshup-app
GUPSHUP_SOURCE_NUMBER=919999999999
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_API_URL=https://api.twilio.com
MESSAGING_WEBHOOK_SECRET=change-this-long-random-webhook-secret

THROTTLE_TENANT_REGISTER=5/hour
THROTTLE_AUTH_OTP=6/minute
THROTTLE_AUTH_VERIFY=12/minute
THROTTLE_DEMO_SESSION=20/minute
THROTTLE_PAYMENT_WEBHOOK=120/minute
THROTTLE_MESSAGING_WEBHOOK=240/minute
THROTTLE_PUBLIC_SHARE=120/minute

E_INVOICE_PROVIDER=your_einvoice_provider
E_INVOICE_API_URL=https://provider.example/einvoice
E_INVOICE_API_TOKEN=change-this-einvoice-token
E_WAY_BILL_PROVIDER=your_eway_bill_provider
E_WAY_BILL_API_URL=https://provider.example/eway-bill
E_WAY_BILL_API_TOKEN=change-this-eway-bill-token

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
AUTH_REFRESH_COOKIE_NAME=vastrabook_refresh
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=True
